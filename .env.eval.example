# P1-C 评测容器专用凭据（不提交到 Git）
# 用法：
#   cp .env.eval.example .env.eval
#   编辑 .env.eval 填入两个密码
#   docker compose -f docker-compose-eval.yml --env-file .env.eval up -d
#
# 生成建议：openssl rand -base64 24
# .env.eval 已在 .gitignore 中忽略，不会进入 Git。

# postgres 超级用户（容器内）
EVAL_DB_PASSWORD=

# eval_runner 用户（Java 端连接评测库使用）
EVAL_RUNNER_PASSWORD=

# 可选：宿主机端口映射（默认 5433，仅绑定 127.0.0.1）
# EVAL_POSTGRES_PORT=5433
